// Title:        wrangler.jsonc — New Thought Nursery
// Author:       Hali Sarah Parsons (I.Q. Productionz)
// Date:         2026-10-25
// Modified By:  Claude (Anthropic), for Hali Sarah Parsons
// Description:  Cloudflare deploy settings for childrens.iqproductionz.com.
// WHY commit this: without it, Wrangler regenerates a config on every build;
// keeping it in the repo makes each deploy predictable.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ntn",
  "compatibility_date": "2026-10-19",
  "observability": { "enabled": true },
  "assets": { "directory": "." }
}
